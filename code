import Foundation

typealias Conta = (
    numero: String,
    senha: String,
    saldo: Double,
    isAdmin: Bool
)

var contas: [Conta] = [
    ("0000", "admin", 0.0, true),
    ("0001", "djasfrwue4wq", 250.0, false),
    ("0002", "483950rfjwklf", 0.01, false),
    ("0003", "senha", 10.00, false)
]

var contaLogada: Conta? = nil

func obterInput() -> String {
    return readLine()?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
}

func obterValor() -> Double? {
    let entrada = obterInput()

    guard let valor = Double(entrada), valor > 0 else {
        print("Valor inválido.")
        return nil
    }

    return valor
}

func criarConta() {
    print("Digite o número da conta:")
    let numero = obterInput()

    if contas.contains(where: { $0.numero == numero }) {
        print("Essa conta já existe.")
        return
    }

    print("Digite a senha da conta:")
    let senha = obterInput()

    if senha.isEmpty {
        print("A senha não pode ser vazia.")
        return
    }

    let conta: Conta = (
        numero: numero,
        senha: senha,
        saldo: 0.0,
        isAdmin: false
    )

    contas.append(conta)

    print("Conta criada com sucesso!")
}

func logar() {
    print("Digite o número da conta:")
    let numero = obterInput()

    print("Digite a senha da conta:")
    let senha = obterInput()

    guard let conta = contas.first(where: {
        $0.numero == numero && $0.senha == senha
    }) else {
        print("Número da conta ou senha incorretos.")
        return
    }

    contaLogada = conta

    print("Login realizado com sucesso!")
}

// MARK: - LOGOUT

func logout() {
    contaLogada = nil
    print("Logout realizado.")
}

func depositar() {
    guard let contaAtual = contaLogada else {
        print("Nenhuma conta logada.")
        return
    }

    print("Digite o valor do depósito:")

    guard let valor = obterValor() else {
        return
    }

    guard let indice = contas.firstIndex(where: {
        $0.numero == contaAtual.numero
    }) else {
        print("Conta não encontrada.")
        return
    }

    contas[indice].saldo += valor

    // Atualiza também a cópia da conta logada
    contaLogada = contas[indice]

    print("Depósito realizado com sucesso!")
    print("Novo saldo: R$ \(String(format: "%.2f", contas[indice].saldo))")
}

func transferir() {
    guard let contaAtual = contaLogada else {
        print("Nenhuma conta logada.")
        return
    }

    print("Digite o número da conta de destino:")
    let numeroDestino = obterInput()

    guard numeroDestino != contaAtual.numero else {
        print("Você não pode transferir para a própria conta.")
        return
    }

    guard let indiceOrigem = contas.firstIndex(where: {
        $0.numero == contaAtual.numero
    }) else {
        print("Conta de origem não encontrada.")
        return
    }

    guard let indiceDestino = contas.firstIndex(where: {
        $0.numero == numeroDestino
    }) else {
        print("Conta de destino não encontrada.")
        return
    }

    print("Digite o valor da transferência:")

    guard let valor = obterValor() else {
        return
    }

    guard contas[indiceOrigem].saldo >= valor else {
        print("Saldo insuficiente.")
        return
    }

    contas[indiceOrigem].saldo -= valor
    contas[indiceDestino].saldo += valor

    // Atualiza a conta logada
    contaLogada = contas[indiceOrigem]

    print("Transferência realizada com sucesso!")
    print("Novo saldo: R$ \(String(format: "%.2f", contas[indiceOrigem].saldo))")
}

func verDados() {
    guard let conta = contaLogada else {
        print("Nenhuma conta logada.")
        return
    }

    print("""
    
    ----- DADOS DA CONTA -----
    Número: \(conta.numero)
    Saldo: R$ \(String(format: "%.2f", conta.saldo))
    ---------------------------
    
    """)
}

func menuConta() {
    guard let conta = contaLogada else {
        return
    }

    if conta.isAdmin {
        menuAdmin()
        return
    }

    print("""
    
    ----- MENU -----
    1. Ver dados
    2. Depositar
    3. Transferir
    4. Logout
    ----------------
    """)

    let resposta = obterInput()

    switch resposta {
    case "1":
        verDados()

    case "2":
        depositar()

    case "3":
        transferir()

    case "4":
        logout()

    default:
        print("Opção inválida.")
    }
}

func menuAdmin() {
    print("""
    
    ----- MENU ADMIN -----
    1. Exibir contas
    2. Logout
    ----------------------
    """)

    let resposta = obterInput()

    switch resposta {
    case "1":
        exibirContas()

    case "2":
        logout()

    default:
        print("Opção inválida.")
    }
}

func exibirContas() {
    for conta in contas {
        print("""
        Número: \(conta.numero)
        Saldo: R$ \(String(format: "%.2f", conta.saldo))
        
        """)
    }
}

func menuPrincipal() {
    print("""
    
    ===== BANCO =====
    1. Criar conta
    2. Login
    3. Sair
    =================
    """)

    let resposta = obterInput()

    switch resposta {
    case "1":
        criarConta()

    case "2":
        logar()

    case "3":
        sair()

    default:
        print("Opção inválida.")
    }
}

func sair() {
    exit(0)
}

while true {
    if contaLogada != nil {
        menuConta()
    } else {
        menuPrincipal()
    }
}
